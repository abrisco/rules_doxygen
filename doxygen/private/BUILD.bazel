load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_cc//cc:defs.bzl", "cc_binary")

cc_binary(
    name = "doxygen_action_runner",
    srcs = ["doxygen_action_runner.cc"],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "doxygen_runner",
    srcs = ["doxygen_runner.cc"],
    visibility = ["//visibility:public"],
    deps = ["@bazel_tools//tools/cpp/runfiles"],
)

# TODO: https://github.com/bazelbuild/rules_cc/issues/279
bzl_library(
    name = "rules_cc",
    srcs = ["@rules_cc//cc:bzl_srcs"],
    deps = ["@rules_cc//cc/common"],
)

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]),
    visibility = ["//doxygen:__pkg__"],
    deps = [":rules_cc"],
)
